# O caminho recomendado é: sh entrega.sh init
# Ele gera .env privado com RUNTIME_DB_PASSWORD aleatória (mínimo 16 caracteres).
# Não copie este exemplo por cima de um .env existente.
# RUNTIME_DB_PASSWORD=

# Portas publicadas em 127.0.0.1; ajuste apenas se houver conflito.
PORT=3000
WORKER_METRICS_PORT=9101
POSTGRES_PORT=5546
LOCALSTACK_PORT=4567
REPORT_PORT=38080
