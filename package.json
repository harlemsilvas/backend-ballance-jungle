{
  "name": "backend-ballance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "bun dist/bootstrap/main.js",
    "dev": "bun --watch src/bootstrap/main.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "migration:pending": "bun scripts/migrate.ts pending",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "worker": "bun dist/bootstrap/workers.js",
    "test:load": "bun scripts/load/run.ts",
    "test:load3000": "bun scripts/load/profile3000.ts",
    "test:load:volume": "bun scripts/load/profile3000.ts --volume"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  }
}
